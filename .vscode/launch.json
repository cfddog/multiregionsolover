{
    // 调试配置：单进程 GDB 调试（需安装 C/C++ 扩展提供 cppdbg）
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug MultiPhysMixSolver (gdb, 单进程)",
            "type": "cppdbg",
            "request": "launch",
            // 可执行文件在 bin/；运行/调试的工作目录必须是含 control.ec 的算例目录，
            // 这里默认指向一个 2 块 AC 算例，按需要改成自己的算例目录。
            "program": "${workspaceFolder}/bin/MultiPhysMixSolver",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/cases/channel_ac_2blk",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Fortran language mode",
                    "text": "set language fortran",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build (make)"
        }
    ]
}
