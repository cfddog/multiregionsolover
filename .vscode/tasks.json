{
    // 任务：编译 / 清理 / 运行 MultiPhysMixSolver
    // 布局：src/ 源码、build/ 中间文件、bin/ 可执行文件、cases/ 算例
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "inputs": [
        {
            "id": "numProcs",
            "type": "promptString",
            "description": "输入 MPI 进程数 (np)",
            "default": "4"
        }
    ],
    "tasks": [
        {
            "label": "build (make)",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gfortran"],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "rebuild (clean + build)",
            "type": "shell",
            "command": "make clean && make",
            "problemMatcher": ["$gfortran"],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "clean (make clean)",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            "label": "run MPI",
            "type": "shell",
            "command": "mpirun -n ${input:numProcs} ./bin/MultiPhysMixSolver",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
