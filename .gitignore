# 对象/编译产物
*.o
*.mod
*.out
work.*
*.pc

# 编辑器/IDE
*.swp
*~

# Python 缓存与临时监控文件
__pycache__/
*.pyc
/snapf.log

# AI 助手/工具本地状态
.deep-copilot/

# 编译日志(src/)
/src/build*.log

# 算例运行产生的监控/临时文件
cases/**/Residual.dat
cases/**/force.log
cases/**/error.log

# 长时间迭代的大体量运行日志（单文件 10~200 MB，不入库；需要时 git add -f）
cases/beavers_joseph/**/run_ac.log
cases/cylinder_re40_200/run_ac40.log
cases/channel_ac_2blk/run.log
cases/channel_ac_4blk/run.log
cases/2D_T_tube/run_ac4.log
cases/2D_T_tube/run_rus.log
cases/square_duct_1977/run.log
cases/**/run_sync.log

# 重启文件与节点流场输出（二进制、体量大；需要时可 git add -f）
cases/**/field_restart.dat
cases/**/flow3d_node.dat

# LaTeX 程序说明（docs/程序说明/）的中间文件；保留 .tex/.pdf/build.sh/README.md
docs/程序说明/*.aux
docs/程序说明/*.log
docs/程序说明/*.toc
docs/程序说明/*.out
docs/程序说明/*.synctex.gz
docs/程序说明/build.log
docs/程序说明/main.pdf

