# 对象/编译产物（新布局：build/ 中间文件、bin/ 可执行文件）
/build/
/bin/
*.o
*.mod
*.d
*.out
work.*
*.pc
# 旧布局残留（src/ 下直接产出，已废弃）
/src/MultiPhysMixSolver

# 编辑器/IDE
*.swp
*~

# Python 缓存与临时监控文件
__pycache__/
*.pyc
/snapf.log

# AI 助手/工具本地状态
.deep-copilot/

# 编译日志(src/)
/src/*.log
/src/*.pre_invfix

# 算例运行产生的监控/临时文件
cases/**/Residual.dat
cases/**/force.log
cases/**/error.log

# 长时间迭代的大体量运行日志（单文件 10~200 MB，不入库；需要时 git add -f）
