$control_ec
!  Case 3 : Block1 = stainless-steel porous wall (eps=0.30), Block2 = Ma=3 air
!           interface code 19 (porous j=1 <-> gas i=max), staggered porous
!           coupling (gas chunk at isothermal wall T_w -> q_w -> porous chunk
!           with coolant injection -> back to T_w).
!           Block1 j=max face = coolant mass inlet, 2 kg/(m^2 s) at 300 K.
!           The porous solver is constant-density (LS_rho=1.177 kg/m3 at 300 K,
!           1 atm), so the coolant mass flux G=2 kg/(m^2 s) is imposed as
!             LS_V_in = Porous_V_in = G/LS_rho = 1.699 m/s   (in +y)
!           LS_Inlet_Type=1 also switches on the blowing (transpiration)
!           coupling variant couple_compressible_porous_blowing_face.
  Iflag_init=0
  Ma=3.0d0
  Re=5000.d0
  AoA=0.d0
  If_viscous=1
  Iflag_turbulence_model=0
  Kstep_save=500
  t_end=1.0d6
  CFL=1.0d0
  Time_Method=0
  T_inf=800.d0
  Twall=-1.d0
  Iflag_Scheme=5
  IFlag_Flux=5
  IFlag_Reconstruction=0
  Ref_S=1.d0
  Ref_L=1.0d0
  Lscale=0.001d0
  Cood_Y_UP=1
  NUM_THREADS=1
  Mesh_File_Format=2
  Kstep_show=50
  Kstep_average=0
  Kstep_smooth=-1
  Kstep_init_smooth=0
  Iflag_local_dt=1
  dt_global=1.0d0
  dtmax=1000.d0
  dtmin=1.d-9
  If_Residual_smoothing=0
  w_LU=1.0d0
  If_dtime_mesh=1
  Num_Mesh=1
  IF_Debug=0
  Step_Inner_Limit=20
  Res_Inner_Limit=1.d-10
  MUT_MAX=-1.d0
  Bound_Scheme=-1
  Pre_Step_Mesh=0,0,0
  Centroid=0.d0,0.d0,0.d0
  IFLAG_LIMIT_FLOW=0
  Pdebug=1,1,1,1
  Ldmin=1.d-6
  Ldmax=1000.d0
  Lpmin=1.d-6
  Lpmax=1000.d0
  Lumax=1000.d0
  LSAmax=1000.d0
  CP1_NSA=0.2d0
  CP2_NSA=100.d0
  Periodic_dX=0.d0
  Periodic_dY=0.d0
  Periodic_dZ=0.d0
  IF_TurboMachinary=0
  Ref_medium_usrdef=0
  IF_Scheme_Positivity=1
  Turbo_P0=101330.d0
  Turbo_T0=288.15d0
  Turbo_L0=1.d0
  Turbo_w=0.d0
  Turbo_Periodic_seta=0.d0
  gamma=1.4d0
  PrL=0.7d0
  PrT=0.9d0
  IF_Innerflow=0
  Iflag_savefile=0
  Iflag_vtk_onefile=1
  Iflag_vtk_SI=1
!---- Block1 porous coolant properties (300 K, 1 atm air) ------------------
  LS_rho=1.177d0
  LS_mu=1.846d-5
  LS_k=0.0262d0
  LS_Cp=1005.d0
  LS_T_ref=300.d0
  LS_Inlet_Type=1
  LS_U_in=0.d0
  LS_V_in=1.699d0
  LS_W_in=0.d0
  LS_Mdot_in=0.d0
  LS_P_in=0.d0
  LS_P_out=0.d0
  LS_T_wall=-1.d0
  LS_U_lid=0.d0
  LS_alpha_p=0.2d0
  LS_alpha_u=0.5d0
  LS_alpha_T=0.7d0
  LS_Max_Iter=150
  LS_Tol=1.d-7
  LS_Scheme=1
  LS_Algorithm=3
!---- AC pseudo-time solver (LS_Algorithm=3), used for the porous block -----
  AC_Max_Iter=5000
  AC_Print=1000
  AC_beta=100.d0
  AC_CFL=20.d0
  AC_CFLv=0.5d0
  AC_Tol=1.d-6
  AC_w=1.d0
!---- porous骨架 / coolant inlet ------------------------------------------
  Porous_T_ref=300.d0
  Porous_alpha_Ts=1.0d0
  Porous_Max_Iter=30000
  Porous_Tol=1.d-8
  Porous_U_in=0.d0
  Porous_V_in=1.699d0
  Porous_W_in=0.d0
  Porous_T_in=300.d0
!---- staggered (segmented) coupling -------------------------------------
  Iflag_Couple_Scheme=1
  Kstep_Couple_Comp=1000
  Niter_Couple_Warm=2
  Kstep_Couple_Min=1
  Niter_Couple_Outer=12
  Porous_Chunk_Iter=3
  Twall_Couple_Init=300.d0
  Tol_Couple_Tw=2.d-2
  Iflag_Couple_WallFlux=0
$end
