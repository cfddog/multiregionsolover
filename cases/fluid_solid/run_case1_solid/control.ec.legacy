$control_ec
!  Case 1 : Block1 = stainless-steel solid (conjugate wall), Block2 = Ma=3 air
!           interface code 11 (solid j=1 <-> gas i=max), staggered CHT coupling
  Iflag_init=0
  Ma=3.0d0
  Re=5000.d0
  AoA=0.d0
  If_viscous=1
  Iflag_turbulence_model=0
  Kstep_save=500
  t_end=1.0d6
  CFL=1.0d0
  Time_Method=0
  T_inf=800.d0
  Twall=-1.d0
  Iflag_Scheme=5
  IFlag_Flux=5
  IFlag_Reconstruction=0
  Ref_S=1.d0
  Ref_L=1.0d0
  Lscale=0.001d0
  Cood_Y_UP=1
  NUM_THREADS=1
  Mesh_File_Format=2
  Kstep_show=50
  Kstep_average=0
  Kstep_smooth=-1
  Kstep_init_smooth=0
  Iflag_local_dt=1
  dt_global=1.0d0
  dtmax=1000.d0
  dtmin=1.d-9
  If_Residual_smoothing=0
  w_LU=1.0d0
  If_dtime_mesh=1
  Num_Mesh=1
  IF_Debug=0
  Step_Inner_Limit=20
  Res_Inner_Limit=1.d-10
  MUT_MAX=-1.d0
  Bound_Scheme=-1
  Pre_Step_Mesh=0,0,0
  Centroid=0.d0,0.d0,0.d0
  IFLAG_LIMIT_FLOW=0
  Pdebug=1,1,1,1
  Ldmin=1.d-6
  Ldmax=1000.d0
  Lpmin=1.d-6
  Lpmax=1000.d0
  Lumax=1000.d0
  LSAmax=1000.d0
  CP1_NSA=0.2d0
  CP2_NSA=100.d0
  Periodic_dX=0.d0
  Periodic_dY=0.d0
  Periodic_dZ=0.d0
  IF_TurboMachinary=0
  Ref_medium_usrdef=0
  IF_Scheme_Positivity=1
  Turbo_P0=101330.d0
  Turbo_T0=288.15d0
  Turbo_L0=1.d0
  Turbo_w=0.d0
  Turbo_Periodic_seta=0.d0
  gamma=1.4d0
  PrL=0.7d0
  PrT=0.9d0
  IF_Innerflow=0
  Iflag_savefile=0
  Iflag_vtk_onefile=1
  Iflag_vtk_SI=1
! low-speed / porous parameters are unused for this pair (kept at defaults)
  LS_rho=1.177d0
  LS_mu=1.846d-5
  LS_k=0.0262d0
  LS_Cp=1005.d0
  LS_T_ref=300.d0
  LS_Inlet_Type=1
  LS_U_in=0.d0
  LS_V_in=0.d0
  LS_W_in=0.d0
  LS_Mdot_in=0.d0
  LS_P_in=0.d0
  LS_P_out=0.d0
  LS_T_wall=-1.d0
  LS_U_lid=0.d0
  LS_alpha_p=0.05d0
  LS_alpha_u=0.25d0
  LS_alpha_T=0.7d0
  LS_Max_Iter=2500
  LS_Tol=5.d-6
  LS_Scheme=3
  LS_Algorithm=3
  AC_Max_Iter=5000
  AC_Print=500
  AC_beta=10.d0
  AC_CFL=2.d0
  AC_CFLv=0.5d0
  AC_Tol=1.d-7
  AC_w=1.d0
  Porous_T_ref=300.d0
  Porous_alpha_Ts=0.7d0
  Porous_Max_Iter=5000
  Porous_Tol=1.d-8
  Porous_U_in=0.d0
  Porous_V_in=0.d0
  Porous_W_in=0.d0
  Porous_T_in=300.d0
!---- staggered (segmented) coupling: gas chunk first, then solid, the gas
!---- chunk length is halved every outer round down to Kstep_Couple_Min=1
!---- (i.e. "run fluid 1000 steps, then the solid, shrink the interval and
!---- finally advance together")
  Iflag_Couple_Scheme=1
  Kstep_Couple_Comp=1000
  Niter_Couple_Warm=2
  Kstep_Couple_Min=1
  Niter_Couple_Outer=12
  Twall_Couple_Init=300.d0
  Tol_Couple_Tw=1.d-2
  Iflag_Couple_WallFlux=0
$end
